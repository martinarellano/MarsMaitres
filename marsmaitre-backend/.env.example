# Nunca subas el valor real al repositorio.
# Mientras cobres en efectivo, mantener este valor en cash.
BILLING_MODE=cash
MERCADOPAGO_ACCESS_TOKEN=TEST-REEMPLAZAR_CON_ACCESS_TOKEN
MARSMAITRE_ADMIN_EMAIL=maartiinaaree.96@gmail.com
MARSMAITRE_ADMIN_PASSWORD=CAMBIAR_A_UNA_CONTRASEÑA_NUEVA
ENVIRONMENT=production
ALLOWED_ORIGIN=https://REEMPLAZAR_CON_PANEL_HTTPS
MARSMAITRE_PUBLIC_URL=https://REEMPLAZAR_CON_DOMINIO_HTTPS
# OAuth individual de Google Calendar (configurar solo en el servidor HTTPS)
GOOGLE_OAUTH_CLIENT_ID=REEMPLAZAR
GOOGLE_OAUTH_CLIENT_SECRET=REEMPLAZAR
GOOGLE_OAUTH_REDIRECT_URI=https://REEMPLAZAR_CON_DOMINIO_HTTPS/oauth/google/callback
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=REEMPLAZAR_CON_CLAVE_FERNET
# Se usa para validar eventos webhook del proveedor de voz AI.
VOICE_WEBHOOK_SECRET=REEMPLAZAR_CON_SECRETO_LARGO
PORT=8787
# En hosting con disco persistente usar, por ejemplo, /data/marsmaitre.db
MARSMAITRE_DB_PATH=/data/marsmaitre.db
